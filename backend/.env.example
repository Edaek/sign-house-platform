# Sign House v3 Backend (mcp-v3 branch) — copy to .env and fill in values
# MCP + Loomy WA run in the same process as /api (PORT below).

# ── Core ────────────────────────────────────────
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
MONGO_URI=mongodb://localhost:27017/signhouse_dev
PORT=5002

# ── CORS ────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://signhousev3.axilogy.io

# ── Hosted MCP (same process as API) ────────────
MCP_HTTP_MOUNT_PREFIX=/mcp
SIGN_HOUSE_API_URL=http://127.0.0.1:5002/api
# Production (Loom per-user): MCP_AUTH_MODE=user — no SIGN_HOUSE_JWT / MCP_BOT_* on server
# MCP_AUTH_MODE=fallback
# SIGN_HOUSE_JWT=
# MCP_BOT_EMAIL=
# MCP_BOT_PASSWORD=
# JWT_ACCESS_TOKEN_HOURS=720          # normal web login (default 24)
# MCP_SERVICE_TOKEN_HOURS=87600       # mint_mcp_token.py only (~10y); web login unchanged
# Long-lived MCP (pick one):
#   A) Cursor/Loom: run scripts/mint_mcp_token.py --email YOU@… → paste Bearer on /mcp/
#   B) Server fallback: MCP_BOT_EMAIL + MCP_BOT_PASSWORD (auto re-login ~20h; MCP_AUTH_MODE=fallback)
#   C) Server static: SIGN_HOUSE_JWT=… from mint script (same as A, on Coolify only)

# ── Wakka WhatsApp API ──────────────────────────
WAKKA_API_URL=https://wakka.example.com
WAKKA_API_KEY=wak_xxxx

# ── Gateway (APP_URL must match PORT) ───────────
GATEWAY_INBOUND_SECRET=dev-gateway-secret
APP_URL=http://localhost:5002

# ── WhatsApp：改一行切换 Loomy ↔ 本机 Agent ─────
# SIGNHOUSE_WA_BRAIN=loom   | agent   （优先于 WA_INBOUND_CLASSIFY_MODE）
# WA_INBOUND_CLASSIFY_MODE=loom   # 旧名，可不设
#
# ── demo：loom（只入库 + Loom Turn 调 /mcp/ 回复）──
# SIGNHOUSE_WA_BRAIN=loom
# MCP_AUTH_MODE=user
# LOOMY_WA_INPROCESS_TOOLS=false
# SIGNHOUSE_WA_GATEWAY=true
# GROUP_REMINDER_ENABLED=false
# POOL_REMINDER_ENABLED=false
# LOOMY_POOL_REMINDER_ENABLED=false
# 长期 token 只在 Loom Connections → wa；勿设 SIGN_HOUSE_JWT / MCP_BOT_EMAIL / MCP_BOT_PASSWORD
#
# ── 本机调试：agent（Sign House Ollama Loomy + Gateway）──
# SIGNHOUSE_WA_BRAIN=agent
# LOOMY_WA_INPROCESS_TOOLS=true
# SIGNHOUSE_WA_GATEWAY=true
# LOOMY_WA_MCP_MAX_ROUNDS=3
# LOOMY_WA_AGENT_DEBOUNCE_S=3
#
# Wakka → Loom 直连（不用 Gateway 收 WA）：SIGNHOUSE_WA_BRAIN=loom + SIGNHOUSE_WA_GATEWAY=false
# Gateway 代发 Loom 文案：LOOM_WA_INBOUND_NOTIFY_URL= + LOOM_WA_INBOUND_NOTIFY_BEARER=
# Loom 已在卡上回复时勿双发：LOOM_WA_RELAY_WHATSAPP_REPLY=   # 见 whatsapp_sent
# agent 但只让 Loom HTTP 说话：LOOMY_WA_DISABLE_LOCAL_OLLAMA=true
# LOOMY_WA_POOL_ACK=   # empty = no local ack on pool intake

# Loom Platform HTTP (Loom model — same as Mattermost; workers need no JWT)
# LOOMY_WA_LOOM_PLATFORM_CLASSIFY=true
# LOOMY_WA_LOOM_PLATFORM_ALL_TURNS=true   # every WA message → Loom (not only pool classify)
# LOOM_PLATFORM_CHAT_URL=
# LOOM_PLATFORM_SERVICE_TOKEN=
# LOOM_PLATFORM_BOT_ID=signhouseloomy
# LOOM_PLATFORM_WA_CHANNEL=whatsapp_chat  # optional; default whatsapp_chat when ALL_TURNS
# LOOMY_WA_LOOM_PLATFORM_FALLBACK_LOCAL=true
# LOOMY_WA_DETERMINISTIC=0                # skip canned weather/greeting before Loom/Ollama
# LOOMY_WA_PROJECT_CATALOGUE=true

# ── Ollama AI ───────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=gemma3:4b
OLLAMA_VISION_MODEL=llava:latest

# ── NAS (SFTP) Upload ──────────────────────────
NAS_HOST=
NAS_PORT=22
NAS_USER=
NAS_PASSWORD=
NAS_BASE_DIR=/Project Photo for Installation
NAS_ENABLED=false

NAS_WATCH_DIR=/Volumes/Project Photo for Installation/Project Photo for Installation
# NAS_FAST_CONNECT=true
# NAS_IO_TIMEOUT_S=45
# NAS_FOLDER_CACHE_REFRESH_S=300
# NAS_FOLDER_CACHE_TTL_S=600

# ── Mac Mini (Tailscale SCP) ───────────────────
MINI_HOST=
MINI_USER=
MINI_SSH_KEY=~/.ssh/id_ed25519
MINI_DEST_DIR=~/Desktop/whats app
MINI_ENABLED=false
MINI_TARGET_GROUP_ID=

# ── Optional ───────────────────────────────────
# NAS_SYNC_INTERVAL_S=60
# ASSIGN_CONFIRM_DEBOUNCE_S=2.0
# WA_UPLOADS_FOLDER=uploads/wa-media
