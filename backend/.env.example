# Sign House v3 Backend — Environment Variables
# Copy to .env and fill in values

# ── Core ────────────────────────────────────────
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
MONGO_URI=mongodb://localhost:27017/signhouse_dev
# Local dev often 5002 if 5000 is taken; MCP repo uses 5010 — keep them different
PORT=5002

# ── CORS ────────────────────────────────────────
# Comma-separated; must include your frontend origin (production example below)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://signhousev3.axilogy.io

# ── Wakka WhatsApp API ──────────────────────────
WAKKA_API_URL=https://wakka.example.com
WAKKA_API_KEY=wak_xxxx

# ── Gateway ─────────────────────────────────────
GATEWAY_INBOUND_SECRET=dev-gateway-secret
APP_URL=http://localhost:5002

# ── Ollama AI ───────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=gemma3:4b
OLLAMA_VISION_MODEL=llava:latest

# ── NAS (SFTP) Upload ──────────────────────────
NAS_HOST=
NAS_PORT=22
NAS_USER=
NAS_PASSWORD=
NAS_BASE_DIR=/Project Photo for Installation
NAS_ENABLED=false

# ── NAS Local Mount ─────────────────────────
# On Mac Mini where NAS is mounted via Finder/SMB
# Creating a WA project auto-creates a folder here
# Must match Finder mount: often …/Project Photo for Installation/Project Photo for Installation/PJ-* (see Get Info → Server)
NAS_WATCH_DIR=/Volumes/Project Photo for Installation/Project Photo for Installation
# Layout: watch dir → PJ-lo-hi range buckets → PJ-xxxx site folders → photo subfolders
# NAS_SCAN_MAX_DEPTH=6
# SMB slow/stale mount (MacBook via tunnel): keep Connected when volume is mounted
# NAS_FAST_CONNECT=true
# NAS_PROBE_TIMEOUT_S=4
# NAS_IO_TIMEOUT_S=45
# NAS_FOLDER_CACHE_REFRESH_S=300
# NAS_FOLDER_CACHE_TTL_S=600

# ── Mac Mini (Tailscale SCP) ───────────────────
MINI_HOST=
MINI_USER=
MINI_SSH_KEY=~/.ssh/id_ed25519
MINI_DEST_DIR=~/Desktop/whats app
MINI_ENABLED=false
MINI_TARGET_GROUP_ID=

# WhatsApp MCP (Cursor / Loom) lives in the separate sign-house-v3-mcp repo — not this deploy.

# ── Optional ───────────────────────────────────
# NAS_SYNC_INTERVAL_S=60
# GROUP_REMINDER_ENABLED=false
# GROUP_REMINDER_INTERVAL_MS=40000
# POOL_REMINDER_ENABLED=false
# ASSIGN_CONFIRM_DEBOUNCE_S=2.0
# WA_UPLOADS_FOLDER=uploads/wa-media
