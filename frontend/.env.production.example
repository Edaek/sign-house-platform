# GitHub Actions / production build (set as repository secrets or CI env)

# Backend origin without /api — required on GitHub Pages
VITE_API_URL=https://your-backend.example.com

# Optional: shown on MCP page for Cursor HTTP URL
VITE_MCP_PUBLIC_URL=https://your-backend.example.com/mcp/

# GitHub Pages project site (default for xerosumio/sign-house-v3-mcp)
VITE_BASE_PATH=/sign-house-v3-mcp/
